{
  "name": "indexer",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "common",
    "api",
    "service"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=indexer-api",
    "dev:service": "turbo run dev --filter=indexer-service",
    "lint": "biome lint",
    "fix": "biome check --write",
    "db:push": "turbo run db:push",
    "db:generate": "turbo run db:generate",
    "db:reset": "bun run ./scripts/reset.ts",
    "test:integration": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "bun": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "@winnr-trade/common": "workspace:*",
    "turbo": "^2.0.0",
    "typescript": "^6.0.2"
  }
}
